@model ConcreteShipping.Models.MixDesign
@{
    ViewData["Title"] = "配合編集";
}

<h2>配合編集</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">配合コード</label>
                    <input asp-for="Code" class="form-control" />
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">配合名</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">強度 (Fc N/mm²)</label>
                    <input asp-for="Strength" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">スランプ (cm)</label>
                    <input asp-for="Slump" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">骨材最大寸法</label>
                    <input asp-for="Aggregate" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">単価 (円/m³)</label>
                    <input asp-for="UnitPrice" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-check mt-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">有効</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">更新</button>
            <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
        </div>
    </div>
</form>
