@model ConcreteShipping.Models.Vehicle
@{
    ViewData["Title"] = "車両登録";
}

<h2>車両登録</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">ナンバープレート</label>
                <input asp-for="LicensePlate" class="form-control" placeholder="例: 品川100 あ 1234" />
            </div>
            <div class="mb-3">
                <label class="form-label">積載量 (m³)</label>
                <input asp-for="Capacity" type="number" step="0.5" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">運転手名</label>
                <input asp-for="DriverName" class="form-control" />
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">登録</button>
            <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
        </div>
    </div>
</form>
