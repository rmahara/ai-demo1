@model IEnumerable<ConcreteShipping.Models.Vehicle>
@{
    ViewData["Title"] = "車両マスタ一覧";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>車両マスタ</h2>
    <a asp-action="Create" class="btn btn-primary">新規追加</a>
</div>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>ナンバー</th>
            <th>積載量 (m³)</th>
            <th>運転手</th>
            <th>有効</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LicensePlate</td>
                <td>@item.Capacity</td>
                <td>@item.DriverName</td>
                <td>@(item.IsActive ? "✓" : "-")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編集</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">削除</a>
                </td>
            </tr>
        }
    </tbody>
</table>
