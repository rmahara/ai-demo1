@model IEnumerable<ConcreteShipping.Models.Customer>
@{
    ViewData["Title"] = "得意先一覧";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>得意先マスタ</h2>
    <a asp-action="Create" class="btn btn-primary">新規追加</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>得意先名</th>
            <th>担当者</th>
            <th>電話番号</th>
            <th>単価</th>
            <th>有効</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.ContactPerson</td>
                <td>@item.Phone</td>
                <td>¥@item.UnitPrice.ToString("N0")</td>
                <td>@(item.IsActive ? "✓" : "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">詳細</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編集</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">削除</a>
                </td>
            </tr>
        }
    </tbody>
</table>
