<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 生コンAI出荷管理</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ConcreteShipping.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- サイドバー -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    生コンAI
                </a>
            </div>

            <hr class="sidebar-divider" />

            <ul class="sidebar-nav">
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                        ダッシュボード
                    </a>
                </li>

                <li class="sidebar-nav-section">受注管理</li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                       asp-controller="Orders" asp-action="Create">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                        受注入力
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Orders" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                        受注一覧
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() == "AssignVehicles" ? "active" : "")"
                       asp-controller="Orders" asp-action="AssignVehicles">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        配車計画
                    </a>
                </li>

                <li class="sidebar-nav-section">出荷管理</li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                       asp-controller="Shipments" asp-action="Create">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        出荷指示
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Shipments" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                        出荷実績一覧
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" && ViewContext.RouteData.Values["action"]?.ToString() == "WeeklyReport" ? "active" : "")"
                       asp-controller="Shipments" asp-action="WeeklyReport">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        週次集計レポート
                    </a>
                </li>

                <li class="sidebar-nav-section">請求管理</li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Billing" ? "active" : "")"
                       asp-controller="Billing" asp-action="Process">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        月次請求処理
                    </a>
                </li>

                <li class="sidebar-nav-section">マスタ管理</li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")"
                       asp-controller="Customers" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        得意先マスタ
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MixDesigns" ? "active" : "")"
                       asp-controller="MixDesigns" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
                        配合マスタ
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active" : "")"
                       asp-controller="Vehicles" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        車両マスタ
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Factories" ? "active" : "")"
                       asp-controller="Factories" asp-action="Index">
                        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                        工場マスタ
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <partial name="_LoginPartial" />
            </div>
        </nav>

        <!-- メインコンテンツ -->
        <div class="main-content">
            <header class="main-header">
                <div class="d-flex align-items-center gap-2">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <span class="main-header-title">@ViewData["Title"]</span>
                </div>
                <span class="text-muted small">@DateTime.Now.ToString("yyyy年MM月dd日")</span>
            </header>

            <main class="main-body">
                @RenderBody()
            </main>

            <footer class="main-footer">
                &copy; 2026 生コンAI出荷管理システム v1.0 (デモ)
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.querySelector('.main-content').classList.toggle('expanded');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>