@model IEnumerable<ConcreteShipping.Models.Factory>
@{
    ViewData["Title"] = "工場マスタ一覧";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>工場マスタ</h2>
    <a asp-action="Create" class="btn btn-primary">新規追加</a>
</div>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>工場名</th>
            <th>住所</th>
            <th>電話番号</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編集</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">削除</a>
                </td>
            </tr>
        }
    </tbody>
</table>
