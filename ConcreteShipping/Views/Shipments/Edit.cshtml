@model ConcreteShipping.Models.Shipment
@{
    ViewData["Title"] = "出荷編集";
}

<h2>出荷編集</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ShippedAt" />
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">受注番号</label>
                    <select asp-for="OrderId" asp-items="ViewBag.Orders" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">車両</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">出荷量 (m³)</label>
                    <input asp-for="Quantity" type="number" step="0.5" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">ステータス</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Dispatched">出荷中</option>
                        <option value="Delivered">配達完了</option>
                    </select>
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">備考</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">更新</button>
            <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
        </div>
    </div>
</form>
