@model ConcreteShipping.Models.Shipment
@{
    ViewData["Title"] = "出荷指示";
}

<h2>出荷指示</h2>

<!-- 意図的な問題: CSRFトークンなし -->
<form asp-action="Create" method="post">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">受注</label>
                    <select asp-for="OrderId" asp-items="ViewBag.Orders" class="form-select">
                        <option value="">-- 受注を選択 --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">車両</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select">
                        <option value="">-- 車両を選択 --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">出荷量 (m³)</label>
                    <input asp-for="Quantity" type="number" step="0.5" class="form-control" />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">備考</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-success">出荷指示登録</button>
            <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
        </div>
    </div>
</form>
